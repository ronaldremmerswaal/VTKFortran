@PACKAGE_INIT@

# Store build configuration
set(VTK_IO_SHARED_BUILD @VTK_IO_SHARED_BUILD@)

# For static libraries, dependencies are embedded but module files are still needed
# For shared libraries, we need to find dependencies
if(VTK_IO_SHARED_BUILD)
    message(STATUS "VTK_IO: Shared library - finding required dependencies")
    
    # Find all required dependencies by including their config files directly
    # The dependencies are installed alongside VTK_IO in the same prefix
    set(_vtk_io_config_dir ${CMAKE_CURRENT_LIST_DIR})
    get_filename_component(_vtk_io_prefix "${_vtk_io_config_dir}/../../.." ABSOLUTE)

    # Include config files directly since naming conventions vary
    include("${_vtk_io_prefix}/lib/cmake/PENF/PENF-config.cmake")
    include("${_vtk_io_prefix}/lib/cmake/BeFoR64/BeFoR64Config.cmake")
    include("${_vtk_io_prefix}/lib/cmake/StringiFor/StringiForConfig.cmake")
    include("${_vtk_io_prefix}/lib/cmake/FACE/FACE-config.cmake")
    include("${_vtk_io_prefix}/lib/cmake/FoXy/FoXyConfig.cmake")
else()
    message(STATUS "VTK_IO: Static library - dependencies embedded, adding module include paths")
endif()

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/VTK_IOTargets.cmake")

# For static libraries, add module include paths after target is created
if(NOT VTK_IO_SHARED_BUILD)
    # For static libraries, we don't need the dependency targets but we still need
    # access to their module files for compilation
    set(_vtk_io_config_dir ${CMAKE_CURRENT_LIST_DIR})
    get_filename_component(_vtk_io_prefix "${_vtk_io_config_dir}/../../.." ABSOLUTE)
    
    # Add include directories for dependency module files
    set_target_properties(VTK_IO::VTK_IO PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_vtk_io_prefix}/include;${_vtk_io_prefix}/include/PENF;${_vtk_io_prefix}/include/BeFoR64;${_vtk_io_prefix}/include/StringiFor;${_vtk_io_prefix}/include/FACE;${_vtk_io_prefix}/include/FoXy"
    )
endif()

check_required_components(VTK_IO)

# Provide helpful information
if(VTK_IO_SHARED_BUILD)
    message(STATUS "VTK_IO: Using shared library (dependencies embedded)")
else()
    message(STATUS "VTK_IO: Using static library (dependencies required)")
endif()